# JWT_SECRET se inyecta desde el entorno o mediante --auth-env ../books-service/.env.
# Nunca uses otra clave: debe coincidir con la que firma los tokens de musa.
PROFILE_SERVICE_URL=http://localhost:8082
BOOKS_SERVICE_URL=http://localhost:8081
# Opcional: artefacto del modelo anterior. El nuevo KNN por características usa PostgreSQL.
# Completar solo si se dispone del artefacto Goodbooks.
MODEL_PATH=

RECOMMENDATIONS_DB_HOST=
RECOMMENDATIONS_DB_PORT=
RECOMMENDATIONS_DB_NAME=
RECOMMENDATIONS_DB_USER=
RECOMMENDATIONS_DB_PASSWORD=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
MUSIC_SERVICE_URL=http://localhost:8080
MUSICBRAINZ_USER_AGENT=musa-recommendations/0.1 (https://github.com/lizethbellop/books-music-platform)

# Preparación automática compartida de libros (presupuesto diario UTC).
BOOK_CATALOG_AUTOPREPARE=true
BOOK_CATALOG_GROQ_DAILY_LIMIT=40
BOOK_CATALOG_GROQ_INTERVAL_SECONDS=35
BOOK_CATALOG_CANDIDATES_PER_BOOK=3

# Cupos de preparación/importación; Books y Music tienen cupos propios.
OPENLIBRARY_DAILY_LIMIT=150
OPENLIBRARY_INTERVAL_SECONDS=3
SPOTIFY_DAILY_LIMIT=20
SPOTIFY_INTERVAL_SECONDS=2

# Ampliación automática musical con fuentes públicas e identidades verificadas.
MUSIC_CATALOG_AUTOPREPARE=true
MUSIC_CATALOG_CANDIDATES_PER_SEED=8
MUSICBRAINZ_DAILY_LIMIT=150
MUSICBRAINZ_INTERVAL_SECONDS=2
# Opcional en desarrollo: ruta al .env de Music para verificar ISRC.
# En despliegue, inyectar SPOTIFY_CLIENT_ID y SPOTIFY_CLIENT_SECRET como secretos.
MUSIC_CATALOG_SPOTIFY_ENV=../music-service/.env
