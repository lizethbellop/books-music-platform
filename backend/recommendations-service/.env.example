# JWT_SECRET se inyecta desde el entorno o mediante --auth-env ../books-service/.env.
# Nunca uses otra clave: debe coincidir con la que firma los tokens de musa.
PROFILE_SERVICE_URL=http://localhost:8082
BOOKS_SERVICE_URL=http://localhost:8081
# Modelo real de Goodbooks; si no lo has copiado, omite MODEL_PATH para usar contenido.
MODEL_PATH=artifacts/books-openlibrary-v2
