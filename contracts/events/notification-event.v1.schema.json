{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://musa.local/contracts/notification-event.v1.schema.json",
  "title": "Notification event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "eventId",
    "type",
    "recipientId",
    "actorId",
    "targetId"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "CHAT_MESSAGE_CREATED",
        "USER_FOLLOWED",
        "POST_LIKED",
        "POST_COMMENTED",
        "POST_PUBLISHED",
        "GROUP_MEMBER_ADDED",
        "GROUP_MEMBER_REMOVED",
        "GROUP_ADMIN_CHANGED"
      ]
    },
    "recipientId": {
      "type": "string",
      "format": "uuid"
    },
    "actorId": {
      "type": "string",
      "format": "uuid"
    },
    "targetId": {
      "type": "string",
      "format": "uuid"
    }
  }
}
